# ==========================================
# Git ignore rules for WorkBOXig
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Distribution & Build Artifacts
build/
dist/
*.egg-info/
*.egg
*.manifest
*.spec.bak

# Local data & backups (Never commit personal schedules/notes)
data/
*.db
*.sqlite3
backup_*.json
workboxig_backup_*.json
*.workboxig

# Virtual Environments
venv/
.venv/
.deps/
.release-smoke/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Temporary files
*.log
temp/
tmp/
*.tmp
